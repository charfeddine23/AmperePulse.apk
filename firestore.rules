rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'isCloudSyncActive', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.isCloudSyncActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTelemetryLog(data) {
      return data.keys().hasOnly(['userId', 'timestamp', 'voltageMv', 'currentMa', 'temperatureC', 'batteryPct', 'state', 'createdAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.timestamp is timestamp
        && data.voltageMv is number && data.voltageMv >= 0 && data.voltageMv <= 10000
        && data.currentMa is number && data.currentMa >= -20000 && data.currentMa <= 20000
        && data.temperatureC is number && data.temperatureC >= -40 && data.temperatureC <= 120
        && data.batteryPct is number && data.batteryPct >= 0 && data.batteryPct <= 100
        && data.state is string && data.state.size() > 0 && data.state.size() <= 32
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /telemetry_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTelemetryLog(request.resource.data);
        allow update: if false; // Telemetry logs are immutable append-only
        allow delete: if isOwner(userId);
      }
    }
  }
}
